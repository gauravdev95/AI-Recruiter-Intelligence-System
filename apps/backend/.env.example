# --- Application ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_recruiter
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# --- Tests only: disposable local Postgres. Never point at a shared database. ---
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ai_recruiter_test
