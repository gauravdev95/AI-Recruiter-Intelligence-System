# Root environment — copy to .env for `docker compose up`
# (the backend container additionally reads apps/backend/.env)

# Database
POSTGRES_USER=recruiter
POSTGRES_PASSWORD=recruiter-dev-secret
POSTGRES_DB=ai_recruiter
DATABASE_URL=postgresql+psycopg://recruiter:recruiter-dev-secret@db:5432/ai_recruiter

# Backend
APP_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Frontend (also see apps/frontend/.env.example)
VITE_API_BASE_URL=http://localhost:8000
